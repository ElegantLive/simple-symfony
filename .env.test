# Test environment.
#
# This file is committed, unlike .env, which is gitignored and holds real
# credentials. Nothing here is a secret, and nothing here should ever be pointed at
# data anyone cares about: the functional suite creates and deletes accounts, and
# resets nothing.
#
# IMPORTANT: APP_ENV has to be exported *before* config/bootstrap.php runs, because
# the file that config/bootstrap.php loads is chosen BY APP_ENV. Setting APP_ENV
# inside this file cannot bootstrap itself:
#
#   APP_ENV=test php bin/console doctrine:schema:create
#   APP_ENV=test php -S 127.0.0.1:8000 -t public public/index.php
#
# The values below are the CI ones, where MySQL and MailHog listen on the runner
# itself. Running the suite against docker-compose.yml needs two overrides, because
# there the database and MailHog are separate containers:
#
#   DATABASE_URL=mysql://root:root@db:3306/simple_test
#   MAILER_DSN=smtp://mailhog:1025
#   SMOKE_MAILHOG_URL=http://mailhog:8025
APP_ENV=test
APP_DEBUG=0
APP_SECRET=test-only-not-a-secret

DATABASE_URL=mysql://root:root@127.0.0.1:3306/simple_test

# MailHog. The registration and password-change flows mail a code and the suite
# reads it back out of MailHog's API - that is the only way to exercise them, since
# the code is never returned in a response.
MAILER_DSN=smtp://127.0.0.1:1025
FROM_EMAIL=from@example.test
DEV_EMAIL=dev@example.test

# config/packages/cache.yaml references this; config/packages/test/cache.yaml
# points the actual pools at the filesystem, so nothing connects to it.
REDIS_DSN=redis://127.0.0.1:6379

# Deliver synchronously so the verification code mail is sent (and the sign-up
# welcome mail rendered) inside the request, with no worker and no queue table to
# keep in step.
MESSENGER_TRANSPORT_DSN=sync://

CORS_ALLOW_ORIGIN=*
