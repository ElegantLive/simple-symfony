# Copy to `.env` in the repo root (it is gitignored) to override docker-compose
# defaults without editing docker-compose.yml.
#
#   cp .env.docker.example .env
#
# Only the variables listed here are read by docker-compose. The application's
# own keys (APP_SECRET, MAILER_DSN, ...) are provided by docker-compose.yml
# itself and deliberately point at the containers, not at localhost.

# --- host ports ------------------------------------------------------------
APP_PORT=8080
DB_PORT=3307
REDIS_PORT=6379
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- database credentials --------------------------------------------------
DB_NAME=simple
DB_USER=root
DB_PASSWORD=root

# --- application -----------------------------------------------------------
APP_ENV=dev
APP_DEBUG=1

# Placeholder. docker-compose.yml falls back to a dummy if this is unset, and
# the real value from your (gitignored) .env is picked up automatically.
APP_SECRET=dev-only-change-me

# --- CORS ------------------------------------------------------------------
# config/packages/nelmio_cors.yaml reads this as a REGEX (origin_regex is on),
# and it is now genuinely applied - it used to be a dead variable while the
# config hardcoded allow_origin: ['*'].
#
# REQUIRED: without it %env(CORS_ALLOW_ORIGIN)% cannot be resolved and requests
# fail. Add every origin your clients use, "|"-separated.
CORS_ALLOW_ORIGIN=^https?://localhost(:[0-9]+)?$

# --- mail ------------------------------------------------------------------
# docker-compose.yml reads MAILER_DSN from here, so the transport inside the
# container is the same one you use outside it:
#   - leave MAILER_DSN unset -> falls back to MailHog on http://localhost:8025
#     and nothing leaves your machine (the default for a fresh clone)
#   - set a real DSN below   -> the container really sends mail
# FROM_EMAIL / DEV_EMAIL are the envelope addresses and the values injected as
# FROM_EMAIL / DEV_EMAIL in the container; they are always taken from here.
FROM_EMAIL=from@example.com
DEV_EMAIL=dev@example.com

# Uncomment to send real mail from inside the container:
#MAILER_DSN=smtp://user:password@smtp.example.com

# Uncomment to force the MailHog sink even if a real DSN is set above:
#MAILER_DSN=smtp://mailhog:1025

# --- composer --------------------------------------------------------------
# composer.json points at the dead packagist.phpcomposer.com mirror. The image
# rewrites Composer's *global* config to this URL at build time - note that a
# project's own `repositories` block wins over global config, so this only helps
# once that broken entry is removed from composer.json. `composer install` works
# regardless: every dist URL in composer.lock is a github.com URL.
COMPOSER_MIRROR=https://mirrors.aliyun.com/composer/

# --- container boot behaviour ----------------------------------------------
# Read by docker/php/entrypoint.sh. All of these are set explicitly by
# docker-compose.yml for the app service, so they are listed here for reference
# only - exporting them in this file will NOT override the compose values.
#
#   RUN_BOOT_TASKS=1        do anything at startup beyond waiting for MySQL
#   RUN_MIGRATIONS=0        OFF on purpose: migrations were abandoned in this repo
#                           (src/Migrations/.gitignore is `*` and the one stale
#                           migration that predated it has been deleted), so there
#                           is nothing to run - the entity mapping is the truth
#   RUN_SCHEMA_UPDATE=0     opt-in per-boot `doctrine:schema:update --force`
#   RUN_CACHE_WARMUP=1      warm the Symfony cache before handing off to php-fpm
#   WAIT_FOR_DB=1           wait for MySQL before starting

